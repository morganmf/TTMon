<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="TTMon.app"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!--
          LibreHardwareMonitorLib instaluje sterownik niskiego poziomu do odczytu
          rejestrow SMU (Ryzen) i ADL (Radeon) - wymaga uprawnien administratora.
          Bez tego program uruchomi sie, ale odczyt sensorow zwroci puste wartosci.
        -->
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" /> <!-- Windows 10/11 -->
    </application>
  </compatibility>

  <!--
    DPI awareness NIE jest tu juz deklarowana recznie (byla, ale kolidowala z
    ApplicationHighDpiMode w .csproj - ostrzezenie kompilatora WFAC010).
    Obsluguje to teraz ApplicationConfiguration.Initialize() w Program.cs w
    polaczeniu z <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    w .csproj - to jest zalecany, nowoczesny sposob w .NET 6+.
  -->
</assembly>
